PORT=5001

JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://nura_app:replace_with_password@localhost:5432/nura?schema=public
SHADOW_DATABASE_URL=postgresql://nura_app:replace_with_password@localhost:5432/nura_shadow?schema=public

